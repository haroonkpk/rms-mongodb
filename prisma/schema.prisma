generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
 
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  SALESMAN
}

model User { 
  id    String  @id 
  email String  @unique
  name  String?
  role  Role    @default(SALESMAN)
  posts Post[]
} 

model Post { 
  id        Int     @id @default(autoincrement()) 
  title     String
  content   String?
  published Boolean @default(false) 
  authorId  String
  author    User    @relation(fields: [authorId], references: [id]) 
} 