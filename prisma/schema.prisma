generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
 
datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  MORNING   // e.g. 06:00 - 14:00
  EVENING   // e.g. 16:00 - 00:00
  NIGHT     // e.g. 22:00 - 06:00
  FULL_DAY  // e.g. 12:00 - 22:00
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  phone    String? @unique
  password String  

  fullName String? @map("full_name")
  role     Role   @default(CASHIER)
  status   EmployeeStatus @default(ACTIVE)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Decimal?     @map("monthly_base_salary") @db.Decimal(10, 2)
  shiftTiming       ShiftTiming? @map("shift_timing")
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([role])
  @@index([status])
}