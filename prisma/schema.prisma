generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
 
datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  MORNING   // e.g. 06:00 - 14:00
  EVENING   // e.g. 16:00 - 00:00
  NIGHT     // e.g. 22:00 - 06:00
  FULL_DAY  // e.g. 12:00 - 22:00
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  phone    String? @unique
  password String  

  fullName String? @map("full_name")
  role     Role   @default(CASHIER)
  status   EmployeeStatus @default(ACTIVE)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Decimal?     @map("monthly_base_salary") @db.Decimal(10, 2)
  shiftTiming       ShiftTiming? @map("shift_timing")
  dailyShiftHours   Decimal?     @default(8.00) @map("daily_shift_hours") @db.Decimal(4, 2)
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")
  
  orders    Order[]
  attendances Attendance[]
  leaves      Leave[]
  payrolls    Payroll[]
  salaryAdvances SalaryAdvance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([role])
  @@index([status])
}

// ------------------------------------------
// MENU MANAGEMENT MODELS
// ------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  hasSizes    Boolean  @default(false) @map("has_sizes")
  sizes       Json?

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addOns    AddOn[]  @relation("MenuItemToAddOn")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("menu_items")
  @@index([categoryId])
  @@index([isAvailable])
}

model AddOn {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  price       Decimal    @db.Decimal(10, 2)
  isAvailable Boolean    @default(true) @map("is_available")
  menuItems   MenuItem[] @relation("MenuItemToAddOn")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("add_ons")
}

// ------------------------------------------
// POS & ORDER MANAGEMENT MODELS
// ------------------------------------------

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR_CODE
  LEDGER
}

enum PaymentStatus {
  PAID
  UNPAID
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique @map("order_number")
  kotNumber     Int?          @map("kot_number")
  cashierId     String?       @map("cashier_id") @db.Uuid
  cashier       User?         @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  subtotal      Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  cashReceived  Decimal?      @map("cash_received") @db.Decimal(10, 2)
  changeGiven   Decimal?      @map("change_given") @db.Decimal(10, 2)
  dueAmount     Decimal?      @default(0) @map("due_amount") @db.Decimal(10, 2)
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("orders")
  @@index([cashierId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?  @map("menu_item_id") @db.Uuid
  itemName   String   @map("item_name")
  variant    String?
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  addOns     String?  @map("add_ons")
  notes      String?

  @@map("order_items")
  @@index([orderId])
}

// ------------------------------------------
// HR & PAYROLL MODELS
// ------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  status      AttendanceStatus
  checkIn     DateTime? @map("check_in") @db.Time
  checkOut    DateTime? @map("check_out") @db.Time
  overtimeHours Decimal? @map("overtime_hours") @db.Decimal(5, 2)
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("attendances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
}

model Leave {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  reason      String
  type        LeaveType @default(CASUAL)
  status      LeaveStatus @default(PENDING)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("leaves")
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum SalaryPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

model Payroll {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int      // 1-12
  year           Int      
  
  // Snapshot fields
  workingDays    Int?     @default(0) @map("working_days")
  presentDays    Int?     @default(0) @map("present_days")
  absentDays     Int?     @default(0) @map("absent_days")
  leaveDays      Int?     @default(0) @map("leave_days")
  totalOvertimeHours Decimal? @default(0) @map("total_overtime_hours") @db.Decimal(5, 2)

  basicSalary    Decimal  @map("basic_salary") @db.Decimal(10, 2)
  overtimePay    Decimal? @default(0) @map("overtime_pay") @db.Decimal(10, 2)
  bonus          Decimal? @default(0) @db.Decimal(10, 2)
  deductions     Decimal? @default(0) @db.Decimal(10, 2)
  advance        Decimal? @default(0) @db.Decimal(10, 2)
  
  netSalary      Decimal  @map("net_salary") @db.Decimal(10, 2)
  status         PayrollStatus @default(DRAFT)
  paymentDate    DateTime? @map("payment_date")
  paymentMethod  SalaryPaymentMethod? @map("payment_method")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, month, year])
  @@map("payrolls")
}

enum AdvanceStatus {
  PENDING
  APPROVED
  PAID
  DEDUCTED // Fully recovered
}

model SalaryAdvance {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(10, 2)
  reason         String?
  status         AdvanceStatus @default(PENDING)
  deductedAmount Decimal  @default(0) @map("deducted_amount") @db.Decimal(10, 2)
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("salary_advances")
}