generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}
 
datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  MORNING   // e.g. 06:00 - 14:00
  EVENING   // e.g. 16:00 - 00:00
  NIGHT     // e.g. 22:00 - 06:00
  FULL_DAY  // e.g. 12:00 - 22:00
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  phone    String? @unique
  password String  

  fullName String? @map("full_name")
  role     Role   @default(CASHIER)
  status   EmployeeStatus @default(ACTIVE)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Decimal?     @map("monthly_base_salary") @db.Decimal(10, 2)
  shiftTiming       ShiftTiming? @map("shift_timing")
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")
  
  orders    Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@index([role])
  @@index([status])
}

// ------------------------------------------
// MENU MANAGEMENT MODELS
// ------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addOns    AddOn[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("menu_items")
  @@index([categoryId])
  @@index([isAvailable])
}

model AddOn {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  price       Decimal   @db.Decimal(10, 2)
  isAvailable Boolean   @default(true) @map("is_available")
  menuItemId  String?   @map("menu_item_id") @db.Uuid
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("add_ons")
  @@index([menuItemId])
}

// ------------------------------------------
// POS & ORDER MANAGEMENT MODELS
// ------------------------------------------

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  QR_CODE
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique @map("order_number")
  cashierId     String?       @map("cashier_id") @db.Uuid
  cashier       User?         @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  cashReceived  Decimal?      @map("cash_received") @db.Decimal(10, 2)
  changeGiven   Decimal?      @map("change_given") @db.Decimal(10, 2)
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("orders")
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?  @map("menu_item_id") @db.Uuid
  itemName   String   @map("item_name")
  variant    String?
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  addOns     String?  @map("add_ons")
  notes      String?

  @@map("order_items")
  @@index([orderId])
}