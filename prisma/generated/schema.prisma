generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  DAY
  NIGHT
  DUAL
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @map("_id")

  email    String  @unique
  phone    String? @unique
  password String

  fullName String? @map("full_name")
  role     Role    @default(CASHIER)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Float?       @map("monthly_base_salary")
  shiftTiming       ShiftTiming? @map("shift_timing")
  dailyShiftHours   Float?       @default(8.00) @map("daily_shift_hours")
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")

  orders         Order[]
  attendances    Attendance[]
  leaves         Leave[]
  payrolls       Payroll[]
  salaryAdvances SalaryAdvance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

// ------------------------------------------
// MENU MANAGEMENT MODELS
// ------------------------------------------

model Category {
  id          String     @id @default(uuid()) @map("_id")
  name        String     @unique
  description String?
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String  @id @default(uuid()) @map("_id")
  name        String
  description String?
  basePrice   Float   @map("base_price")
  imageUrl    String? @map("image_url")
  isAvailable Boolean @default(true) @map("is_available")
  hasSizes    Boolean @default(false) @map("has_sizes")
  sizes       Json?
  ingredients Json?

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addOnIds   String[]    @map("add_on_ids")
  addOns     AddOn[]     @relation("MenuItemToAddOn", fields: [addOnIds], references: [id])
  orderItems OrderItem[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model AddOn {
  id          String     @id @default(uuid()) @map("_id")
  name        String
  price       Float
  isAvailable Boolean    @default(true) @map("is_available")
  ingredients Json?
  menuItemIds String[]   @map("menu_item_ids")
  menuItems   MenuItem[] @relation("MenuItemToAddOn", fields: [menuItemIds], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("add_ons")
}

// ------------------------------------------
// POS & ORDER MANAGEMENT MODELS
// ------------------------------------------

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR_CODE
  LEDGER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerLedgerEntryType {
  CHARGE
  PAYMENT
}

model Customer {
  id            String                @id @default(uuid()) @map("_id")
  name          String
  phone         String                @unique
  email         String?
  notes         String?
  status        CustomerStatus        @default(ACTIVE)
  orders        Order[]
  ledgerEntries CustomerLedgerEntry[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("customers")
}

model CustomerLedgerEntry {
  id         String                  @id @default(uuid()) @map("_id")
  customerId String                  @map("customer_id")
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?                 @map("order_id")
  order      Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type       CustomerLedgerEntryType
  amount     Float
  note       String?
  createdAt  DateTime                @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([orderId])
  @@map("customer_ledger_entries")
}

model Order {
  id            String                @id @default(uuid()) @map("_id")
  orderNumber   String                @unique @map("order_number")
  kotNumber     Int?                  @map("kot_number")
  cashierId     String?               @map("cashier_id")
  cashier       User?                 @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customerId    String?               @map("customer_id")
  customer      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ledgerEntries CustomerLedgerEntry[]
  orderType     OrderType             @default(DINE_IN) @map("order_type")
  status        OrderStatus           @default(COMPLETED)
  paymentMethod PaymentMethod         @default(CASH)
  paymentStatus PaymentStatus         @default(PAID) @map("payment_status")
  subtotal      Float
  totalAmount   Float                 @map("total_amount")
  cashReceived  Float?                @map("cash_received")
  changeGiven   Float?                @map("change_given")
  dueAmount     Float?                @default(0) @map("due_amount")
  customerName  String?               @map("customer_name")
  customerPhone String?               @map("customer_phone")
  notes         String?
  items         OrderItem[]
  cogsExpense   Expense?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([cashierId])
  @@index([customerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid()) @map("_id")
  orderId    String    @map("order_id")
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?   @map("menu_item_id")
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String    @map("item_name")
  variant    String?
  quantity   Int
  unitPrice  Float     @map("unit_price")
  totalPrice Float     @map("total_price")
  addOns     String?   @map("add_ons")
  notes      String?

  @@index([orderId])
  @@map("order_items")
}

model KotSequence {
  id              Int       @id @default(1) @map("_id")
  currentNumber   Int       @default(0) @map("current_number")
  windowStartedAt DateTime? @map("window_started_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("kot_sequences")
}

// ------------------------------------------
// HR & PAYROLL MODELS
// ------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id            String           @id @default(uuid()) @map("_id")
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  status        AttendanceStatus
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  overtimeHours Float?           @map("overtime_hours")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("attendances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
}

model Leave {
  id        String      @id @default(uuid()) @map("_id")
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime    @map("start_date")
  endDate   DateTime    @map("end_date")
  reason    String
  type      LeaveType   @default(CASUAL)
  status    LeaveStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leaves")
}

enum PayrollStatus {
  DRAFT
  PAID
}

enum SalaryPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

model ExpenseType {
  id        String   @id @default(uuid()) @map("_id")
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("expense_types")
}

model Expense {
  id            String               @id @default(uuid()) @map("_id")
  title         String
  expenseType   String               @map("expense_type")
  amount        Float
  expenseDate   DateTime             @map("expense_date")
  paymentMethod ExpensePaymentMethod @default(CASH) @map("payment_method")
  orderId       String?              @unique @map("order_id")
  order         Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expenseDate])
  @@index([expenseType])
  @@map("expenses")
}

model Payroll {
  id     String @id @default(uuid()) @map("_id")
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month  Int // 1-12
  year   Int

  // Snapshot fields
  workingDays        Int?   @default(0) @map("working_days")
  presentDays        Int?   @default(0) @map("present_days")
  absentDays         Int?   @default(0) @map("absent_days")
  leaveDays          Int?   @default(0) @map("leave_days")
  totalOvertimeHours Float? @default(0) @map("total_overtime_hours")

  basicSalary        Float  @map("basic_salary")
  overtimePay        Float? @default(0) @map("overtime_pay")
  bonus              Float? @default(0)
  deductions         Float? @default(0)
  advance            Float? @default(0)
  carriedOverBalance Float? @default(0) @map("carried_over_balance")
  paidAmount         Float? @default(0) @map("paid_amount")

  netSalary     Float                @map("net_salary")
  status        PayrollStatus        @default(DRAFT)
  paymentDate   DateTime?            @map("payment_date")
  paymentMethod SalaryPaymentMethod? @map("payment_method")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, month, year])
  @@map("payrolls")
}

enum AdvanceStatus {
  PENDING
  APPROVED
  PAID
  DEDUCTED // Fully recovered
}

model SalaryAdvance {
  id             String        @id @default(uuid()) @map("_id")
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  reason         String?
  status         AdvanceStatus @default(PENDING)
  deductedAmount Float         @default(0) @map("deducted_amount")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("salary_advances")
}

// ------------------------------------------
// INVENTORY & STOCK MANAGEMENT MODELS
// ------------------------------------------

enum StockMovementType {
  PURCHASE_IN
  WASTAGE_OUT
  SPOILAGE_OUT
  MANUAL_ADJUSTMENT
  SALE_DEDUCTION
}

enum InventoryUnit {
  KG
  GRAM
  LITER
  ML
  PIECE
  PACK
  BOX
}

model InventoryCategory {
  id        String          @id @default(uuid()) @map("_id")
  name      String          @unique
  items     InventoryItem[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("inventory_categories")
}

model InventoryItem {
  id            String            @id @default(uuid()) @map("_id")
  name          String
  categoryId    String            @map("category_id")
  category      InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  unit          InventoryUnit     @default(KG)
  quantity      Float             @default(0)
  minStockLevel Float             @default(10) @map("min_stock_level")
  unitCost      Float             @default(0) @map("unit_cost")

  movements        StockMovement[]
  stockIntakeItems StockIntakeBatchItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([quantity])
  @@map("inventory_items")
}

model StockMovement {
  id               String            @id @default(uuid()) @map("_id")
  inventoryItemId  String            @map("inventory_item_id")
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type             StockMovementType
  quantityChange   Float             @map("quantity_change")
  previousQuantity Float             @map("previous_quantity")
  newQuantity      Float             @map("new_quantity")
  reason           String?
  createdById      String?           @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockIntakeBatch {
  id          String                 @id @default(uuid()) @map("_id")
  batchNumber String                 @unique @map("batch_number")
  notes       String?
  totalAmount Float                  @map("total_amount")
  items       StockIntakeBatchItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stock_intake_batches")
}

model StockIntakeBatchItem {
  id                 String           @id @default(uuid()) @map("_id")
  stockIntakeBatchId String           @map("stock_intake_batch_id")
  stockIntakeBatch   StockIntakeBatch @relation(fields: [stockIntakeBatchId], references: [id], onDelete: Cascade)
  inventoryItemId    String           @map("inventory_item_id")
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity           Float
  unitCost           Float            @map("unit_cost")
  totalPrice         Float            @map("total_price")

  @@index([stockIntakeBatchId])
  @@index([inventoryItemId])
  @@map("stock_intake_batch_items")
}
