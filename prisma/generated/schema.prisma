generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  MORNING // e.g. 06:00 - 14:00
  EVENING // e.g. 16:00 - 00:00
  NIGHT // e.g. 22:00 - 06:00
  FULL_DAY // e.g. 12:00 - 22:00
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  phone    String? @unique
  password String

  fullName String?        @map("full_name")
  role     Role           @default(CASHIER)
  status   EmployeeStatus @default(ACTIVE)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Decimal?     @map("monthly_base_salary") @db.Decimal(10, 2)
  shiftTiming       ShiftTiming? @map("shift_timing")
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")

  orders Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("users")
}

// ------------------------------------------
// MENU MANAGEMENT MODELS
// ------------------------------------------

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  menuItems   MenuItem[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2)
  imageUrl    String? @map("image_url")
  isAvailable Boolean @default(true) @map("is_available")
  hasSizes    Boolean @default(false) @map("has_sizes")
  sizes       Json?

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addOns    AddOn[]  @relation("MenuItemToAddOn")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model AddOn {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  price       Decimal    @db.Decimal(10, 2)
  isAvailable Boolean    @default(true) @map("is_available")
  menuItems   MenuItem[] @relation("MenuItemToAddOn")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("add_ons")
}

// ------------------------------------------
// POS & ORDER MANAGEMENT MODELS
// ------------------------------------------

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR_CODE
  LEDGER
}

enum PaymentStatus {
  PAID
  UNPAID
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique @map("order_number")
  cashierId     String?       @map("cashier_id") @db.Uuid
  cashier       User?         @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  subtotal      Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  cashReceived  Decimal?      @map("cash_received") @db.Decimal(10, 2)
  changeGiven   Decimal?      @map("change_given") @db.Decimal(10, 2)
  dueAmount     Decimal?      @default(0) @map("due_amount") @db.Decimal(10, 2)
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([cashierId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String? @map("menu_item_id") @db.Uuid
  itemName   String  @map("item_name")
  variant    String?
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)
  addOns     String? @map("add_ons")
  notes      String?

  @@index([orderId])
  @@map("order_items")
}
