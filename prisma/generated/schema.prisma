generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS
// ------------------------------------------

enum Role {
  ADMIN
  CASHIER
  CHEF
}

enum ShiftTiming {
  MORNING // e.g. 06:00 - 14:00
  EVENING // e.g. 16:00 - 00:00
  NIGHT // e.g. 22:00 - 06:00
  FULL_DAY // e.g. 12:00 - 22:00
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

// ------------------------------------------
// USER MODEL 
// ------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  phone    String? @unique
  password String

  fullName String?        @map("full_name")
  role     Role           @default(CASHIER)
  status   EmployeeStatus @default(ACTIVE)

  // Employee & Staff Management Page fields
  monthlyBaseSalary Decimal?     @map("monthly_base_salary") @db.Decimal(10, 2)
  shiftTiming       ShiftTiming? @map("shift_timing")
  hiredAt           DateTime?    @map("hired_at")

  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("users")
}

// ------------------------------------------
// MENU MANAGEMENT MODELS
// ------------------------------------------

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  menuItems MenuItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model MenuItem {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2)
  imageUrl    String? @map("image_url")
  isAvailable Boolean @default(true) @map("is_available")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  addOns    AddOn[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model AddOn {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  price       Decimal   @db.Decimal(10, 2)
  isAvailable Boolean   @default(true) @map("is_available")
  menuItemId  String?   @map("menu_item_id") @db.Uuid
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([menuItemId])
  @@map("add_ons")
}
